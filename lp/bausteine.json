      "adresse":      { "typ": "kennung", "label": "Adresse der Seite im Netz", "muster": "^https://[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+/\\z", "fehlt": "die Seite gibt beim Teilen keine Karte aus (og:url, og:image, twitter:card); setzt der Betreiber, nie der Kunde" },
