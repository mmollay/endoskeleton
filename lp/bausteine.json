        "ort":       { "typ": "zeile", "label": "Ort", "max": 120, "pflicht": true },
        "wenn_leer": { "typ": "zeile", "label": "Text ohne Termin", "max": 120, "pflicht": true },
        "preis":     { "typ": "zahl", "label": "Preis in Euro", "min": 0, "max": 9999,
                       "fehlt": "Die Seite zeigt keine Preiszeile und meldet Suchmaschinen weder „kostenlos“ noch einen Preis; „Teilnahme kostenlos“ und `isAccessibleForFree` gibt es nur bei ausdrücklich `preis` 0" },
        "knopf":     { "typ": "knopf", "label": "Knopf" }
      },
      "regeln": { "hoechstens": 2 },
      "beispiel": {
        "typ": "termin", "variante": "karte", "titel": "Nächster Termin", "art": "online",
        "termine": [{ "beginn": "2099-10-06T19:00", "dauer_min": 60 }],
        "ort": "Online über Zoom – den Link bekommst du per E-Mail", "wenn_leer": "Der nächste Termin steht bald fest."
